@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam sequenceMessageAlign left
skinparam BoxPadding 20

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "f:FindCommand" as FindCommand LOGIC_COLOR
participant "r:\nCommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "filteredPersons:\nFilteredList" as FilteredList MODEL_COLOR
participant "p:Predicate" as Predicate MODEL_COLOR
end box

activate LogicManager
LogicManager -> FindCommand : execute(m)
activate FindCommand
FindCommand -> Model : updateFilteredPersonList(p)
activate Model
Model -> FilteredList : setPredicate(p)
activate FilteredList
loop each person
    FilteredList -> Predicate : test(person)
    activate Predicate
    note left of Predicate
    Substring match,
    ignoring case:
    "Alice Tan" contains "ali".
    end note
    Predicate --> FilteredList : matches
    deactivate Predicate
end
FilteredList --> Model
deactivate FilteredList
Model --> FindCommand
deactivate Model

FindCommand -> Model : getFilteredPersonList()
activate Model
Model --> FindCommand : filteredPersons
deactivate Model
FindCommand -> FilteredList : size()
activate FilteredList
FilteredList --> FindCommand : count
deactivate FilteredList

create CommandResult
FindCommand -> CommandResult : new CommandResult\n(formatted count message)
activate CommandResult
CommandResult --> FindCommand : r
deactivate CommandResult
FindCommand --> LogicManager : r
deactivate FindCommand
LogicManager -> FindCommand : requiresSave()
activate FindCommand
FindCommand --> LogicManager : false
deactivate FindCommand
[<-- LogicManager : r
deactivate LogicManager
@enduml
